# Copie para .env se precisar sobrescrever algo. O .env nunca é versionado.
# Com o provedor padrão (Ollama local) nenhuma chave é necessária.

# Opcionais: sobrescrevem valores de config.yaml
# RADAR_LLM_PROVIDER=ollama          # ollama | anthropic
# RADAR_LLM_MODE=cache_only          # live | cache_only (cache_only nunca chama o modelo)
# RADAR_OLLAMA_URL=http://localhost:11434
# RADAR_CLASSIFIER_MODEL=qwen3:4b
# RADAR_AGENT_MODEL=qwen3:4b

# Só se RADAR_LLM_PROVIDER=anthropic (pago; ajuste também os papéis em config.yaml)
# ANTHROPIC_API_KEY=
